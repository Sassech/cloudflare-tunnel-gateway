# cf-watcher provisions its own Cloudflare Tunnel on first boot (one tunnel
# per VPS, all in the same account). This file can be identical on every
# VPS, except DOCKER_GID (host-specific) and, if two VPSes could share the
# same hostname, CF_TUNNEL_NAME.
#
# CF_API_TOKEN permissions (dash.cloudflare.com/profile/api-tokens ->
# Create Token -> Custom token):
#   - Account -> Cloudflare Tunnel -> Edit   (always)
#   - Zone    -> DNS               -> Edit   (only if any container uses
#                                             cf.dns=true; scope it to the
#                                             zone set in CF_ZONE_ID)

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------
# API token needs: Account:Cloudflare Tunnel:Edit + Zone:DNS:Edit (for cf.dns)
CF_API_TOKEN=
CF_ACCOUNT_ID=

# Docker GID of the host's docker group (for non-root docker.sock access).
# Run on each VPS: getent group docker | cut -d: -f3
DOCKER_GID=

# ---------------------------------------------------------------------------
# Required if using cf.dns=true labels
# ---------------------------------------------------------------------------
CF_ZONE_ID=

# ---------------------------------------------------------------------------
# Optional (defaults shown)
# ---------------------------------------------------------------------------

# Name of the tunnel cf-watcher reuses or creates. Must be unique per VPS —
# never set the same value on two VPSes. Default: cf-watcher-<host hostname>.
CF_TUNNEL_NAME=cf-watcher-NAME

# Escape hatch: pin an existing tunnel by UUID instead of provisioning by
# name (CF_TUNNEL_NAME is then ignored). Unset by default. Never set the same
# value on two VPSes.
# CF_TUNNEL_ID=

# Where cf-watcher writes the tunnel connector token for cloudflared. Must
# match the shared volume and cloudflared's --token-file in
# docker-compose.yaml — change it only if you change those too.
# TUNNEL_TOKEN_FILE=/run/cloudflared/token

# DOCKER_NETWORK=cloudflared-network

# Valid: DEBUG, INFO, WARNING, ERROR (unrecognized values fall back to INFO)
# LOG_LEVEL=INFO

# DEBOUNCE_SECONDS=2.0

# Health/metrics HTTP server. Set to "off" to disable — NOT recommended:
# cloudflared waits for cf-watcher's healthcheck, which then passes
# immediately, before the tunnel token is written.
# HEALTH_ADDR=:9090

# Enables POST /reload when set (disabled/404 by default). Required as the
# X-Reload-Token header value on every reload request.
# RELOAD_TOKEN=